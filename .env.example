BASE_URL=https://automationexercise.com
API_BASE_URL=https://automationexercise.com
BROWSER=chrome
HEADLESS=false
QA_PROFILE=default

# LLM providers — copy real values into local .env (never commit)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Role → provider mapping (openai | anthropic | deepseek)
REQUIREMENT_LLM=openai
TESTGEN_LLM=openai
REVIEWER_LLM=anthropic
AUTOMATOR_LLM=anthropic
REPORT_LLM=deepseek

# Email / SES (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
SES_FROM_EMAIL=
SES_TO_EMAIL=
REPORT_EMAIL_ENABLED=false
