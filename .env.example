BASE_URL=https://automationexercise.com
API_BASE_URL=https://automationexercise.com
BROWSER=chromium
HEADLESS=true
QA_PROFILE=default

# LLM providers — copy real values into local .env (never commit)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Role → provider mapping (openai | anthropic | deepseek)
REQUIREMENT_LLM=openai
TESTGEN_LLM=openai
REVIEWER_LLM=openai
AUTOMATOR_LLM=openai
REPORT_LLM=deepseek

# Email / SES (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
SES_FROM_EMAIL=
SES_TO_EMAIL=
REPORT_EMAIL_ENABLED=false
