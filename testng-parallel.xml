<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Agentic QA Parallel Suite" verbose="1" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="com.agenticqa.core.reporting.TestListener"/>
        <listener class-name="com.agenticqa.core.reporting.ExtentTestListener"/>
        <listener class-name="com.agenticqa.core.configuration.ParallelSuiteAlterer"/>
    </listeners>
    <test name="All Tests">
        <packages>
            <package name="com.agenticqa.tests.*"/>
        </packages>
    </test>
</suite>
